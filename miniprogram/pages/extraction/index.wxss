.processing{padding:70rpx 30rpx;text-align:center;margin-top:28rpx}.processing text{display:block}.processing text:nth-child(2){font-size:30rpx;font-weight:650;margin-top:20rpx}.processing text:last-child{font-size:21rpx;color:#8993a3;margin-top:9rpx}.spinner{width:54rpx;height:54rpx;border:6rpx solid #e6e3fa;border-top-color:#6558d5;border-radius:50%;margin:auto;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.result-summary{display:grid;grid-template-columns:1fr 120rpx;gap:20rpx;align-items:center;padding:25rpx;margin-top:24rpx}.result-summary text{display:block}.company{font-size:29rpx;font-weight:700;margin-bottom:8rpx}.company+text{font-size:21rpx;color:#7e8999;line-height:1.5}.result-summary>view:last-child{text-align:center}.result-summary>view:last-child text:first-child{font-size:40rpx;font-weight:700;color:#218060}.result-summary>view:last-child text:last-child{font-size:18rpx;color:#8993a3}.target{display:flex;justify-content:space-between;align-items:center;padding:22rpx 25rpx;margin-top:15rpx;font-size:23rpx}.target>text{color:#7d8797}.target picker{color:#5d50c9;font-weight:600}.review-tools{display:flex;align-items:center;justify-content:space-between;margin:25rpx 2rpx 12rpx;font-size:24rpx;font-weight:650}.review-tools button{margin:0;height:56rpx;line-height:56rpx;padding:0 15rpx;background:#f0eeff;color:#6255ce;font-size:19rpx}.finding-list{display:grid;gap:13rpx}.finding{display:grid;grid-template-columns:42rpx 1fr;gap:13rpx;padding:21rpx}.finding.selected{border-color:#8275df;background:#fbfaff}.finding.unmatched{background:#fffaf4}.finding-head{display:flex;justify-content:space-between;gap:12rpx}.finding-head>text:first-child{font-size:19rpx;padding:5rpx 10rpx;border-radius:99rpx;background:#f0eeff;color:#6255ce}.citation{font-size:18rpx;color:#218060}.unmatched .citation{color:#a36b1b}.finding-title,.finding-value,.finding-quote,.finding-page{display:block}.finding-title{font-size:26rpx;font-weight:650;margin-top:10rpx}.finding-value{font-size:24rpx;color:#4f5d72;margin-top:6rpx}.finding-quote{font-size:20rpx;line-height:1.55;color:#7f8999;margin-top:10rpx}.finding-page{font-size:18rpx;color:#929baa;margin-top:8rpx}.accept{position:sticky;bottom:24rpx;margin-top:24rpx;height:78rpx;line-height:78rpx;box-shadow:0 12rpx 35rpx rgba(101,88,213,.25)}
.result-summary>view:first-child,.finding>view{min-width:0}.company,.company+text,.finding-title,.finding-value,.finding-quote,.finding-page{overflow-wrap:anywhere}.target{gap:18rpx}.target picker{min-width:0;text-align:right}
