.profile{display:grid;grid-template-columns:78rpx 1fr auto;gap:18rpx;align-items:center;padding:25rpx;margin-top:27rpx}.avatar{width:74rpx;height:74rpx;border-radius:50%;background:#efedff;color:#6255ce;display:flex;align-items:center;justify-content:center;font-size:31rpx;font-weight:700}.profile-name,.profile-id{display:block}.profile-name{font-size:29rpx;font-weight:650}.profile-id{font-size:20rpx;color:#929baa;margin-top:6rpx}.setting-card{padding:26rpx;margin-top:18rpx}.section-title{display:block;font-size:25rpx;font-weight:650;margin-bottom:12rpx}.setting-row{display:flex;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #eceef2;font-size:22rpx}.setting-row text:first-child{color:#8993a3}.setting-row text:last-child{text-align:right}.setting-card input{height:74rpx;border:1rpx solid #dfe3e9;border-radius:14rpx;padding:0 18rpx;margin-top:18rpx}.setting-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:16rpx}.setting-actions button{margin:0;height:62rpx;line-height:62rpx;padding:0 20rpx;font-size:21rpx}.security-note{padding:24rpx;margin-top:18rpx;background:#f7f5ff;border-color:#e0dcfa}.security-note text{display:block}.security-note text:first-child{font-size:24rpx;font-weight:650;color:#5e51c7}.security-note text:last-child{font-size:21rpx;line-height:1.65;color:#7b719f;margin-top:8rpx}.logout{margin-top:30rpx;height:72rpx;line-height:72rpx}
.setting-hint{display:block;font-size:21rpx;line-height:1.6;color:#8993a3}.wide{width:100%;margin-top:16rpx}.export-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:16rpx}.export-actions button{margin:0;padding:0;font-size:20rpx;background:#f0eeff;color:#5f52cb}
.service.ready{color:#21805f!important}.service.pending{color:#a06c19!important}
.profile>view:nth-child(2){min-width:0}.profile-name,.profile-id{overflow-wrap:anywhere}.setting-row text:last-child{min-width:0;overflow-wrap:anywhere}.export-actions button{white-space:normal;line-height:1.35;min-height:72rpx}
