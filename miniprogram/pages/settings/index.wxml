<view class="page settings-page" wx:if="{{session}}">
  <text class="eyebrow">MINI PROGRAM SETTINGS</text><text class="page-title">账号与连接</text><text class="page-subtitle">小程序只保存当前登录会话；DeepSeek Key 始终留在后端。</text>
  <view class="profile card"><view class="avatar">{{avatar}}</view><view><text class="profile-name">{{session.user.display_name}}</text><text class="profile-id">{{session.user.email||'微信账号'}}</text></view><text class="pill">{{session.workspace.role==='owner'?'所有者':session.workspace.role==='editor'?'编辑者':'查看者'}}</text></view>
  <view class="setting-card card"><text class="section-title">当前研究上下文</text><view class="setting-row"><text>研究空间</text><text>{{session.workspace.name}}</text></view><view class="setting-row"><text>当前项目</text><text>{{projectTitle}}</text></view></view>
  <view class="setting-card card"><text class="section-title">团队与权限</text><text class="setting-hint">查看空间成员；所有者可以邀请已注册账号并调整编辑或查看权限。</text><button class="secondary wide" bindtap="openMembers">管理研究空间成员 ›</button><button class="secondary wide" loading="{{busy}}" bindtap="createWorkspace">＋ 新建研究空间</button></view>
  <view class="setting-card card"><text class="section-title">服务状态</text><view class="setting-row"><text>DeepSeek</text><text class="service {{system.ai_configured?'ready':'pending'}}">{{system.ai_configured?'已配置 · '+system.ai_model:'尚未配置'}}</text></view><view class="setting-row"><text>微信正式登录</text><text class="service {{system.wechat_configured?'ready':'pending'}}">{{system.wechat_configured?'后端已配置':'尚未配置'}}</text></view><button class="secondary wide" loading="{{busy}}" bindtap="bindWechat">绑定当前微信账号</button></view>
  <view class="setting-card card"><text class="section-title">精准导出</text><text class="setting-hint">导出当前云端版本，自动包含产业节点、关系、证据、任务、公司映射和年报表格。</text><view class="export-actions"><button data-format="pdf" loading="{{exporting==='pdf'}}" disabled="{{exporting}}" bindtap="exportProject">PDF 报告</button><button data-format="docx" loading="{{exporting==='docx'}}" disabled="{{exporting}}" bindtap="exportProject">Word 报告</button><button data-format="xlsx" loading="{{exporting==='xlsx'}}" disabled="{{exporting}}" bindtap="exportProject">Excel 数据</button></view></view>
  <view class="setting-card card"><text class="section-title">后端服务</text><input value="{{baseUrl}}" bindinput="input" placeholder="https://api.example.com"/><view class="setting-actions"><button class="secondary" bindtap="save">保存地址</button><button class="primary" loading="{{busy}}" bindtap="test">测试连接</button></view><view wx:if="{{message}}" class="feedback">{{message}}</view></view>
  <view class="security-note card"><text>密钥与费用安全</text><text>模型密钥不会写入小程序代码或本机存储。正式上线前还需要在微信公众平台配置 HTTPS request 合法域名。</text></view>
  <button class="logout danger" bindtap="logout">退出当前账号</button>
</view>
