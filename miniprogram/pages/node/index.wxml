<view class="page node-page" wx:if="{{node}}">
  <view class="node-hero card"><text class="eyebrow">{{node.category}}</text><text class="node-name">{{node.title}}</text><view class="node-badges"><text class="pill">{{node.status==='verified'?'已核验':node.status==='evidenced'?'已有证据':node.status==='edited'?'人工整理':'待研究'}}</text><text>{{evidence.length}} 条证据</text><text>{{companies}} 家公司</text></view></view>
  <view wx:if="{{readOnly}}" class="readonly-banner">当前为只读权限，研究内容无法修改。</view>
  <view wx:if="{{message}}" class="feedback">{{message}}</view>
  <view class="research-card card"><view class="section-title"><text>研究卡片</text><button wx:if="{{!readOnly}}" class="secondary" disabled="{{busy}}" bindtap="addChild">＋ 新增下级</button></view><view class="field compact"><text>节点名称</text><input value="{{title}}" disabled="{{readOnly}}" data-field="title" bindinput="field" maxlength="80"/></view><view class="field compact"><text>节点分类</text><input value="{{category}}" disabled="{{readOnly}}" data-field="category" bindinput="field" maxlength="100"/></view><view class="field"><text>一句话解释</text><textarea value="{{summary}}" disabled="{{readOnly}}" data-field="summary" bindinput="field" maxlength="1200"/></view><view class="field"><text>为什么重要</text><textarea value="{{why}}" disabled="{{readOnly}}" data-field="why" bindinput="field" maxlength="1200"/></view><view class="field compact"><text>关键指标（用顿号分隔）</text><input value="{{metricsText}}" disabled="{{readOnly}}" data-field="metricsText" bindinput="field" placeholder="市场规模、毛利率、产能利用率"/></view><view class="field compact"><text>关键瓶颈（用顿号分隔）</text><input value="{{bottlenecksText}}" disabled="{{readOnly}}" data-field="bottlenecksText" bindinput="field" placeholder="设备、材料、良率"/></view><button wx:if="{{!readOnly}}" class="save primary" loading="{{busy}}" bindtap="save">{{saved?'已保存云端':'保存并同步云端'}}</button></view>
  <view class="detail-card card"><text class="section-heading">关键指标</text><view class="tag-list"><text wx:for="{{node.metrics}}" wx:key="*this">{{item}}</text><text wx:if="{{!node.metrics.length}}" class="muted">尚未设置</text></view></view>
  <view class="detail-card card"><text class="section-heading">关键瓶颈</text><view class="tag-list bottleneck"><text wx:for="{{node.bottlenecks}}" wx:key="*this">{{item}}</text><text wx:if="{{!node.bottlenecks.length}}" class="muted">尚未记录</text></view></view>
  <view class="evidence-section"><text class="section-heading">研究证据 · {{evidence.length}}</text><view wx:if="{{!readOnly}}" class="manual-evidence card"><input value="{{evidenceTitle}}" data-field="evidenceTitle" bindinput="field" placeholder="证据标题"/><input value="{{evidenceLocation}}" data-field="evidenceLocation" bindinput="field" placeholder="来源或页码"/><textarea value="{{evidenceQuote}}" data-field="evidenceQuote" bindinput="field" placeholder="原文摘录或研究记录"/><button class="secondary" loading="{{busy}}" disabled="{{!evidenceTitle||!evidenceQuote||busy}}" bindtap="addEvidence">添加证据并同步</button></view><view wx:for="{{evidence}}" wx:key="id" class="evidence-card card"><view class="evidence-icon">文</view><view><text class="evidence-title">{{item.title}}</text><text class="evidence-location">{{item.location||'位置待核对'}}</text><text class="evidence-quote">{{item.quote}}</text></view><button wx:if="{{!readOnly}}" class="verify {{item.verified?'active':''}}" data-id="{{item.id}}" bindtap="toggleEvidence">{{item.verified?'已核验':'待核验'}}</button><text wx:elif="{{item.verified}}" class="verified">已核验</text></view><view wx:if="{{!evidence.length}}" class="empty card"><text>这个节点还没有证据，可在此手工添加，或到“资料”页上传年报并提取。</text></view></view>
  <button wx:if="{{!readOnly&&id!==rootId}}" class="delete-node danger" bindtap="removeNode">删除此节点及下级</button>
</view>
