.node-hero{padding:30rpx}.node-name{display:block;font-size:42rpx;font-weight:700;margin-top:10rpx}.node-badges{display:flex;align-items:center;gap:17rpx;color:#8993a3;font-size:20rpx;margin-top:20rpx}.research-card,.detail-card{padding:26rpx;margin-top:18rpx}.section-title{display:flex;align-items:center;justify-content:space-between;font-size:29rpx;font-weight:650}.section-title button{margin:0;height:59rpx;line-height:59rpx;padding:0 18rpx;font-size:21rpx}.field{margin-top:23rpx}.field>text,.section-heading{display:block;font-size:23rpx;font-weight:650;color:#526075}.field textarea,.field input{width:100%;border:1rpx solid #dfe3e9;border-radius:15rpx;padding:18rpx;box-sizing:border-box;margin-top:10rpx;background:#fff}.field textarea{height:170rpx;line-height:1.6}.field input{height:76rpx}.field textarea[disabled],.field input[disabled]{background:#f6f7f9;color:#697588}.field.compact{margin-top:18rpx}.save{margin-top:24rpx;height:74rpx;line-height:74rpx}.tag-list{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:17rpx}.tag-list text{font-size:21rpx;padding:9rpx 14rpx;border-radius:12rpx;background:#f0eeff;color:#6255ce}.tag-list.bottleneck text{background:#fff5e9;color:#98631a}.tag-list text.muted{background:#f3f4f6;color:#929baa}.evidence-section{margin-top:26rpx}.evidence-card{display:grid;grid-template-columns:58rpx 1fr auto;gap:15rpx;padding:21rpx;margin-top:13rpx}.evidence-icon{width:54rpx;height:54rpx;border-radius:14rpx;background:#fff0ef;color:#c75c55;display:flex;align-items:center;justify-content:center;font-size:22rpx}.evidence-card text{display:block}.evidence-title{font-size:25rpx;font-weight:650}.evidence-location{font-size:19rpx;color:#929baa;margin-top:5rpx}.evidence-quote{font-size:21rpx;line-height:1.55;color:#6f7a8c;margin-top:10rpx}.verified{font-size:18rpx;color:#188864}
.manual-evidence{padding:20rpx;margin-top:14rpx}.manual-evidence input,.manual-evidence textarea{width:100%;box-sizing:border-box;border:1rpx solid #dfe3e9;border-radius:13rpx;padding:15rpx;margin-top:10rpx}.manual-evidence textarea{height:135rpx}.manual-evidence button{margin-top:12rpx}.verify{width:84rpx;height:52rpx;line-height:52rpx;margin:0;padding:0;font-size:18rpx;background:#f2f4f7;color:#7d8797}.verify.active{background:#eaf7f1;color:#217c5f}.delete-node{margin-top:28rpx}.verified{font-size:18rpx;color:#188864}
.node-name{overflow-wrap:anywhere}.node-badges{flex-wrap:wrap}.evidence-card>view:nth-child(2){min-width:0}.evidence-title,.evidence-location,.evidence-quote{overflow-wrap:anywhere}
