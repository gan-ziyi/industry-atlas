.page-head{display:flex;align-items:flex-start;justify-content:space-between}.page-head>view{flex:1}.create{margin:4rpx 0 0 18rpx;padding:0 24rpx;height:68rpx;line-height:68rpx}.workspace-card{padding:24rpx;margin-top:27rpx}.workspace-card>text{font-size:21rpx;font-weight:600;color:#7c8797}.workspace-picker{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx}.workspace-picker>text{color:#6558d5;font-size:23rpx}.workspace-name,.workspace-role{display:block}.workspace-name{font-size:29rpx;font-weight:650}.workspace-role{font-size:21rpx;color:#9099a8;margin-top:7rpx}.project-list{display:grid;gap:18rpx;margin-top:22rpx}.project-card{padding:25rpx;display:grid;grid-template-columns:76rpx 1fr;gap:18rpx}.project-card.current{border-color:#7a6dde;box-shadow:0 0 0 4rpx #efedff}.folder{width:72rpx;height:72rpx;border-radius:18rpx;background:#efedff;color:#6255ce;display:flex;align-items:center;justify-content:center;font-size:35rpx}.project-info text{display:block}.project-kicker{font-size:18rpx;letter-spacing:2rpx;color:#7467da}.project-title{font-size:31rpx;font-weight:700;margin-top:8rpx}.project-time{font-size:20rpx;color:#929baa;margin-top:8rpx}.project-actions{grid-column:1/-1;border-top:1rpx solid #eceef2;padding-top:18rpx;display:flex;justify-content:flex-end;gap:12rpx}.project-actions button{margin:0;padding:0 20rpx;height:59rpx;line-height:59rpx;font-size:21rpx}
.create-actions{display:flex;flex-direction:column;gap:10rpx;margin-left:16rpx}.create-actions .create{width:150rpx;margin:0;font-size:20rpx;padding:0}.ai-create{background:#f0eeff;color:#5f52cb;border:1rpx solid #dcd7ff}
.page-head>view{flex:initial}.page-head>view:first-child{flex:1;min-width:0}.create-actions{flex:0 0 150rpx}.workspace-picker{gap:16rpx}.workspace-picker>view,.project-info{min-width:0}.workspace-picker>text{flex:0 0 auto}.workspace-name,.workspace-role,.project-title{overflow-wrap:anywhere}.project-card{grid-template-columns:76rpx minmax(0,1fr)}.project-actions{flex-wrap:wrap}
