.filters{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;background:#e9ecf1;border-radius:16rpx;padding:7rpx;margin-top:27rpx}.filters button{height:62rpx;line-height:62rpx;margin:0;padding:0;background:transparent;color:#7d8797;font-size:21rpx}.filters button.active{background:#fff;color:#5d50c9;box-shadow:0 4rpx 13rpx rgba(31,42,61,.07)}.task-list{display:grid;gap:14rpx;margin-top:19rpx}.task-card{display:grid;grid-template-columns:9rpx 1fr 100rpx;gap:17rpx;align-items:center;padding:22rpx}.priority{width:9rpx;height:76rpx;border-radius:99rpx;background:#98a2b1}.priority.high{background:#e25e56}.priority.medium{background:#e7a43b}.priority.low{background:#3aa27d}.task-top{display:flex;align-items:center;gap:13rpx;color:#929baa;font-size:19rpx}.task-status{padding:6rpx 11rpx;border-radius:99rpx;background:#f2f4f7;color:#687487}.task-status.doing{background:#fff4de;color:#956319}.task-status.done{background:#eaf7f1;color:#217c5f}.task-content>text{display:block}.task-title{font-size:27rpx;font-weight:650;margin-top:9rpx}.task-node{font-size:20rpx;color:#7568d5;margin-top:7rpx}.task-note{font-size:20rpx;color:#818b9b;line-height:1.5;margin-top:8rpx}.task-card>button{width:96rpx;height:58rpx;line-height:58rpx;padding:0;margin:0;background:#f0eeff;color:#6255ce;font-size:21rpx}
.create-task{padding:24rpx;margin-top:24rpx}.create-title{display:block;font-size:27rpx;font-weight:650}.create-task>input{height:76rpx;border:1rpx solid #dfe3e9;border-radius:14rpx;padding:0 18rpx;margin-top:16rpx}.task-selectors{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:13rpx}.task-selectors picker{background:#f5f6f8;border-radius:13rpx;padding:18rpx;font-size:21rpx;color:#626e80}.create-task>button{margin-top:16rpx}
.task-card{grid-template-columns:9rpx minmax(0,1fr) 100rpx}.task-content{min-width:0}.task-top{flex-wrap:wrap}.task-title,.task-node,.task-note{overflow-wrap:anywhere}.task-selectors picker{min-width:0;overflow:hidden}
