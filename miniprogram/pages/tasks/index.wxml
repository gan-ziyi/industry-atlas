<view class="page task-page" wx:if="{{state}}">
  <text class="eyebrow">RESEARCH TASKS</text><text class="page-title">研究任务</text><text class="page-subtitle">跟踪产业拆解、证据补充和人工核验进度。</text>
  <view wx:if="{{readOnly}}" class="readonly-banner">当前为只读空间，不能推进任务状态。</view>
  <view wx:if="{{!readOnly}}" class="create-task card"><text class="create-title">新建研究任务</text><input value="{{taskTitle}}" bindinput="field" placeholder="例如：核验光模块市场规模口径"/><view class="task-selectors"><picker mode="selector" range="{{nodeNames}}" value="{{nodeIndex}}" bindchange="pickNode"><view>{{nodeNames[nodeIndex]||'选择产业节点'}} ›</view></picker><picker mode="selector" range="{{priorities}}" value="{{priorityIndex}}" bindchange="pickPriority"><view>{{priorities[priorityIndex]}} ›</view></picker></view><button class="primary" loading="{{busy}}" disabled="{{!taskTitle||busy}}" bindtap="createTask">创建并同步</button></view>
  <view wx:if="{{message}}" class="feedback">{{message}}</view>
  <view class="filters"><button data-filter="all" class="{{filter==='all'?'active':''}}" bindtap="setFilter">全部</button><button data-filter="todo" class="{{filter==='todo'?'active':''}}" bindtap="setFilter">待处理</button><button data-filter="doing" class="{{filter==='doing'?'active':''}}" bindtap="setFilter">进行中</button><button data-filter="done" class="{{filter==='done'?'active':''}}" bindtap="setFilter">已完成</button></view>
  <view class="task-list"><view wx:for="{{tasks}}" wx:key="id" class="task-card card"><view class="priority {{item.priority}}"></view><view class="task-content" data-id="{{item.nodeId}}" bindtap="openNode"><view class="task-top"><text class="task-status {{item.status}}">{{item.statusLabel}}</text><text>{{item.priorityLabel}}优先级</text></view><text class="task-title">{{item.title}}</text><text class="task-node">关联节点 · {{item.nodeTitle}}</text><text wx:if="{{item.note}}" class="task-note">{{item.note}}</text></view><button wx:if="{{!readOnly}}" data-id="{{item.id}}" catchtap="advance">{{item.status==='todo'?'开始':item.status==='doing'?'完成':'重开'}}</button></view></view>
  <view wx:if="{{!tasks.length}}" class="empty card"><text class="empty-title">当前筛选没有任务</text><text>可以在上方直接创建，并关联到具体产业节点。</text></view>
</view>
