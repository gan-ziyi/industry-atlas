.login-page{min-height:100vh;background:linear-gradient(160deg,#101827 0%,#17243a 43%,#f4f6f9 43%);padding:82rpx 32rpx 50rpx;box-sizing:border-box}.login-hero{display:flex;flex-direction:column;align-items:center;color:#fff;margin-bottom:46rpx}.brand-mark{width:86rpx;height:86rpx;border-radius:24rpx;background:linear-gradient(145deg,#8e80ef,#5748c5);display:flex;align-items:center;justify-content:center;font-size:48rpx;box-shadow:0 20rpx 55rpx rgba(102,87,214,.35)}.brand-name{font-size:36rpx;font-weight:700;margin-top:20rpx}.brand-cn{font-size:21rpx;color:#8d99ad;margin-top:7rpx;letter-spacing:2rpx}.login-card{padding:38rpx 34rpx}.login-title{display:block;font-size:39rpx;font-weight:700;margin-top:12rpx}.login-desc{display:block;font-size:23rpx;color:#8993a3;line-height:1.6;margin-top:9rpx}.mode-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;background:#f1f3f6;border-radius:16rpx;padding:7rpx;margin-top:32rpx}.mode-tabs button{margin:0;background:transparent;color:#7c8797;font-size:21rpx;padding:0 8rpx}.mode-tabs button.active{background:#fff;color:#5d50c9;box-shadow:0 4rpx 15rpx rgba(31,42,61,.07)}.field{display:grid;grid-template-columns:1fr 104rpx;gap:10rpx;margin-top:25rpx}.field>text{grid-column:1/-1;font-size:22rpx;font-weight:600;color:#526075}.field input{height:74rpx;border:1rpx solid #dfe3e9;border-radius:14rpx;padding:0 20rpx;background:#fff}.field button{height:74rpx;line-height:74rpx;margin:0;font-size:21rpx;background:#f0eeff;color:#6255ce}.field.simple{display:block}.field.simple input{margin-top:10rpx}.safe-note{font-size:21rpx;line-height:1.6;color:#6f63cc;background:#f5f3ff;border-radius:14rpx;padding:17rpx 19rpx;margin-top:22rpx}.login-button{margin-top:30rpx;height:82rpx;line-height:82rpx}.login-foot{display:block;text-align:center;color:#9099a8;font-size:20rpx;line-height:1.6;margin:28rpx 35rpx}
.email-toggle{width:100%;margin-top:18rpx;background:transparent;color:#6255ce;font-size:21rpx;text-decoration:underline}
.login-page{padding-bottom:calc(50rpx + env(safe-area-inset-bottom));overflow-x:hidden}.login-card,.login-hero{max-width:686rpx;margin-left:auto;margin-right:auto}.brand-cn,.login-title,.login-desc,.safe-note,.login-foot{overflow-wrap:anywhere}.mode-tabs button{white-space:nowrap}
