.ai-page{padding-bottom:150rpx}.prompt{padding:26rpx;margin-top:24rpx}.section-title{display:block;font-size:28rpx;font-weight:650}.prompt textarea{width:100%;height:190rpx;box-sizing:border-box;background:#f7f8fa;border:1rpx solid #e2e6ec;border-radius:16rpx;padding:20rpx;margin-top:18rpx;line-height:1.55}.prompt button{margin-top:18rpx}.patch-list{display:grid;gap:16rpx;margin-top:20rpx}.patch{display:block;padding:24rpx}.patch-head{display:flex;align-items:flex-start;gap:14rpx}.patch-head>view{flex:1}.patch-title,.patch-scope{display:block}.patch-title{font-size:28rpx;font-weight:650}.patch-scope{font-size:20rpx;color:#776bd7;margin-top:5rpx}.change{padding:17rpx;border-radius:14rpx;margin-top:15rpx}.change text{display:block;font-size:22rpx;line-height:1.55}.change text:first-child{font-size:18rpx;font-weight:700;margin-bottom:5rpx}.before{background:#fff4f2;color:#96534d}.after{background:#eefaf5;color:#28765b}.reason{display:flex;gap:12rpx;margin-top:15rpx;font-size:20rpx;color:#7d8797;line-height:1.5}.reason text:first-child{flex:0 0 auto;color:#5f52cb;font-weight:650}.review-bar{position:fixed;left:0;right:0;bottom:0;z-index:5;background:rgba(255,255,255,.96);border-top:1rpx solid #e1e5eb;padding:18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between}.review-bar text{font-size:22rpx;color:#657084}.review-bar button{width:230rpx;margin:0}
.review-bar button{flex:0 0 230rpx}.patch-head>view{min-width:0}.patch-title,.patch-scope,.change text,.reason text{overflow-wrap:anywhere}
