.materials-head{display:flex;align-items:flex-start}.materials-head>view{flex:1}.materials-head>button{margin:4rpx 0 0 16rpx;width:144rpx;height:68rpx;line-height:68rpx;padding:0;font-size:22rpx}.document-list{display:grid;gap:15rpx;margin-top:23rpx}.document-card{display:grid;grid-template-columns:78rpx 1fr;gap:18rpx;padding:23rpx}.pdf-icon{width:74rpx;height:84rpx;border-radius:17rpx;background:#fff0ef;color:#c75b54;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:700}.document-top{display:flex;align-items:flex-start;gap:10rpx}.document-name{flex:1;font-size:26rpx;font-weight:650;word-break:break-all}.state{font-size:18rpx;padding:6rpx 10rpx;border-radius:99rpx;background:#eef0f3;color:#738093}.state.ready{background:#eaf7f1;color:#217c5f}.state.failed,.state.ocr_failed{background:#fff0ed;color:#b14e47}.document-meta,.document-error{display:block;font-size:20rpx;color:#8993a3;margin-top:10rpx}.document-error{color:#b14e47;line-height:1.5}.document-actions{display:flex;gap:10rpx;margin-top:16rpx}.document-actions button{margin:0;height:58rpx;line-height:58rpx;padding:0 16rpx;background:#fff;border:1rpx solid #dfe3e9;color:#667286;font-size:20rpx}.document-actions button.ai{background:#f0eeff;color:#6255ce;border-color:#ddd9fa}
.materials-head>view,.document-main{min-width:0}.materials-head>button,.state{flex:0 0 auto}.document-card{grid-template-columns:78rpx minmax(0,1fr)}.document-name{min-width:0}.document-meta,.document-error{overflow-wrap:anywhere}.document-actions{flex-wrap:wrap}
