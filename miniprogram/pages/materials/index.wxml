<view class="page materials-page" wx:if="{{project}}">
  <view class="materials-head"><view><text class="eyebrow">DOCUMENT RESEARCH</text><text class="page-title">资料与年报</text><text class="page-subtitle">{{project.title}} · 上传 PDF 后保留页码、原文与提取状态。</text></view><button wx:if="{{!readOnly}}" class="primary" loading="{{busy}}" bindtap="choosePdf">上传 PDF</button></view>
  <view wx:if="{{readOnly}}" class="readonly-banner">查看者可以浏览文件状态，但不能上传、OCR 或调用 AI。</view><view wx:if="{{message}}" class="feedback">{{message}}</view>
  <view class="document-list"><view wx:for="{{documents}}" wx:key="id" class="document-card card"><view class="pdf-icon">PDF</view><view class="document-main"><view class="document-top"><text class="document-name">{{item.filename}}</text><text class="state {{item.status}}">{{item.statusLabel}}</text></view><text class="document-meta">{{item.page_count}} 页 · {{item.char_count}} 字符 · {{item.table_count}} 个表格</text><text wx:if="{{item.error}}" class="document-error">{{item.error}}</text><view wx:if="{{!readOnly}}" class="document-actions"><button wx:if="{{item.needs_ocr || item.status==='ocr_failed'}}" data-id="{{item.id}}" bindtap="ocr">运行 OCR</button><button wx:if="{{item.status==='ready'}}" class="ai" data-id="{{item.id}}" bindtap="extract">DeepSeek 提取</button></view></view></view></view>
  <view wx:if="{{!busy && !documents.length}}" class="empty card"><text class="empty-title">还没有研究资料</text><text>从微信聊天文件中选择公司年报或行业 PDF。</text></view>
</view>
