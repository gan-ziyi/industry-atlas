.invite{display:grid;grid-template-columns:1fr 170rpx;gap:12rpx;padding:24rpx;margin-top:24rpx}.section-title{grid-column:1/-1;font-size:26rpx;font-weight:650}.invite input,.invite picker{height:72rpx;line-height:72rpx;border:1rpx solid #dfe3e9;border-radius:14rpx;padding:0 17rpx}.invite button{grid-column:1/-1}.member-list{display:grid;gap:13rpx;margin-top:20rpx}.member{display:grid;grid-template-columns:62rpx 1fr auto auto;align-items:center;gap:14rpx;padding:20rpx}.avatar{width:58rpx;height:58rpx;border-radius:50%;background:#efedff;color:#6255ce;display:flex;align-items:center;justify-content:center;font-weight:700}.member-name,.member-email{display:block}.member-name{font-size:25rpx;font-weight:650}.member-email{font-size:19rpx;color:#929baa;margin-top:4rpx}.role-picker{font-size:20rpx;color:#6255ce;background:#f0eeff;border-radius:12rpx;padding:10rpx}.member button{width:76rpx;margin:0;padding:0;font-size:19rpx}
.member-main{min-width:0}.member-name,.member-email{overflow-wrap:anywhere}.role-picker{white-space:nowrap}
