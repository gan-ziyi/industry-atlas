.company-create{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;padding:24rpx;margin-top:22rpx}.section-title{grid-column:1/-1;font-size:26rpx;font-weight:650}.company-create input,.company-create picker{height:72rpx;line-height:72rpx;border:1rpx solid #dfe3e9;border-radius:14rpx;padding:0 16rpx}.company-create picker,.company-create button{grid-column:1/-1}.search{height:76rpx;display:flex;align-items:center;gap:12rpx;padding:0 20rpx;margin-top:18rpx}.search input{flex:1}.company-list{display:grid;gap:16rpx;margin-top:18rpx}.company{padding:24rpx}.company-head{display:flex;justify-content:space-between;gap:15rpx}.company-name,.company-period{display:block}.company-name{font-size:30rpx;font-weight:700}.company-period{font-size:19rpx;color:#8478dc;margin-top:6rpx}.company-head button{width:74rpx;margin:0;padding:0;font-size:19rpx}.company-summary{display:block;font-size:21rpx;color:#778294;line-height:1.55;margin-top:14rpx}.mapping-title{font-size:22rpx;font-weight:650;margin-top:20rpx}.mapping{display:grid;grid-template-columns:1fr auto;gap:12rpx;background:#f7f8fa;border-radius:14rpx;padding:16rpx;margin-top:10rpx;border-left:7rpx solid #d9a441}.mapping.confirmed{border-left-color:#2e9b73}.mapping.rejected{border-left-color:#a8b0bc;opacity:.72}.mapping text{display:block;font-size:20rpx;line-height:1.45}.mapping text:first-child{font-size:23rpx;font-weight:650}.mapping text:nth-child(2){color:#7669d4;margin-top:3rpx}.mapping text:nth-child(3){color:#8993a3;margin-top:5rpx}.mapping-actions{display:flex;flex-direction:column;gap:7rpx}.mapping-actions button{width:72rpx;height:48rpx;line-height:48rpx;margin:0;padding:0;font-size:18rpx;background:#efedff;color:#6255ce}
.company-head>view,.mapping>view{min-width:0}.company-name,.company-summary,.mapping text{overflow-wrap:anywhere}
