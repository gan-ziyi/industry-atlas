<view class="page company-page" wx:if="{{state}}">
  <text class="eyebrow">COMPANY MAPPING</text><text class="page-title">公司与产业映射</text><text class="page-subtitle">公司是产业链研究的验证对象；先完善产业结构，再确认公司属于哪一环。</text>
  <view wx:if="{{!readOnly}}" class="company-create card"><text class="section-title">新增公司档案</text><input value="{{name}}" data-field="name" bindinput="field" placeholder="公司名称"/><input value="{{period}}" data-field="period" bindinput="field" placeholder="报告期，例如 2025 年报"/><picker mode="selector" range="{{nodeNames}}" value="{{nodeIndex}}" bindchange="pickNode"><view>映射到：{{nodeNames[nodeIndex]||'选择产业节点'}} ›</view></picker><button class="primary" loading="{{busy}}" disabled="{{!name||busy}}" bindtap="add">创建并确认映射</button></view>
  <view class="search card"><text>⌕</text><input value="{{query}}" bindinput="search" placeholder="搜索公司、报告期或摘要"/></view><view wx:if="{{message}}" class="feedback">{{message}}</view>
  <view class="company-list"><view wx:for="{{companies}}" wx:key="id" class="company card"><view class="company-head"><view><text class="company-name">{{item.name}}</text><text class="company-period">{{item.reportPeriod||'报告期未识别'}} · {{item.findings.length}} 条年报发现</text></view><button wx:if="{{!readOnly}}" class="danger" data-id="{{item.id}}" bindtap="remove">删除</button></view><text class="company-summary">{{item.summary||'暂无公司摘要，可通过年报提取补充。'}}</text><view class="mapping-title">产业节点映射 · {{item.mappings.length}}</view><view wx:for="{{item.mappings}}" wx:for-item="mapping" wx:key="id" class="mapping {{mapping.status}}"><view><text>{{mapping.nodeTitle}}</text><text>{{mapping.statusLabel}} · {{mapping.score||0}} 分</text><text>{{mapping.reason}}</text></view><view wx:if="{{!readOnly}}" class="mapping-actions"><button wx:if="{{mapping.status!=='confirmed'}}" data-company="{{item.id}}" data-mapping="{{mapping.id}}" data-status="confirmed" bindtap="setMapping">确认</button><button wx:if="{{mapping.status!=='rejected'}}" data-company="{{item.id}}" data-mapping="{{mapping.id}}" data-status="rejected" bindtap="setMapping">排除</button><button wx:if="{{mapping.status==='rejected'}}" data-company="{{item.id}}" data-mapping="{{mapping.id}}" data-status="suggested" bindtap="setMapping">恢复</button></view></view></view></view>
  <view wx:if="{{!companies.length}}" class="empty card"><text class="empty-title">还没有公司档案</text><text>可手动创建，或从“资料”页接纳年报提取结果后自动生成。</text></view>
</view>
