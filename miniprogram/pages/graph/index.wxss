.graph-head{display:flex;align-items:flex-start}.graph-head>view:first-child{flex:1}.graph-actions{width:150rpx;display:flex;flex-direction:column;gap:10rpx;margin:5rpx 0 0 16rpx}.graph-actions button{width:150rpx;height:62rpx;line-height:62rpx;padding:0;margin:0;font-size:20rpx}.ai-edit{background:#f0eeff;color:#5f52cb;border:1rpx solid #dcd7ff}.sync{background:#6558d5;color:#fff}.sync.readonly{background:#e9ebef;color:#8a94a4}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:13rpx;margin-top:24rpx}.metrics>view{padding:20rpx 14rpx;text-align:center}.metrics text{display:block}.metrics text:first-child{font-size:37rpx;font-weight:700;color:#4f43b6}.metrics text:last-child{font-size:19rpx;color:#8993a3;margin-top:5rpx}.search{height:78rpx;display:flex;align-items:center;padding:0 22rpx;gap:13rpx;margin-top:18rpx;color:#8993a3}.search input{flex:1}.node-list{display:grid;gap:13rpx;margin-top:19rpx;overflow:hidden}.node-row{position:relative;display:grid;grid-template-columns:10rpx 1fr 56rpx;gap:15rpx;align-items:center;padding:20rpx;max-width:100%;box-sizing:border-box}.status{width:10rpx;height:58rpx;border-radius:99rpx;background:#94a3b8}.status.verified{background:#16a36a}.status.evidenced{background:#14b8a6}.status.ai_draft{background:#8b5cf6}.status.edited{background:#3b82f6}.node-main text{display:block}.node-category{font-size:18rpx;color:#7a6ed9}.node-title{font-size:28rpx;font-weight:650;margin-top:5rpx}.node-summary{font-size:21rpx;color:#7d8797;line-height:1.5;margin-top:7rpx;display:-webkit-box!important;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.node-meta{display:flex;gap:15rpx;margin-top:10rpx}.node-meta text{font-size:18rpx;color:#9aa3b1}.toggle{width:52rpx;height:52rpx;line-height:50rpx;padding:0;margin:0;background:#f0eeff;color:#6255ce}.arrow{font-size:40rpx;color:#98a1af;text-align:center}
.company-metric{border-color:#dcd7ff!important;background:#faf9ff!important}
.graph-head>view:first-child,.node-main{min-width:0}.node-title,.node-category{overflow-wrap:anywhere}.node-meta{flex-wrap:wrap}.node-row{width:auto}.node-list{padding-right:1rpx}
