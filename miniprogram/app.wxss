page{background:#f4f6f9;color:#243148;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}.page{min-height:100vh;padding:28rpx 26rpx 48rpx;box-sizing:border-box}.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#7467da;font-weight:700}.page-title{font-size:44rpx;line-height:1.25;margin:10rpx 0 8rpx;font-weight:700}.page-subtitle{font-size:23rpx;line-height:1.6;color:#8490a1}.card{background:#fff;border:1rpx solid #e3e7ed;border-radius:22rpx;box-shadow:0 8rpx 28rpx rgba(31,42,61,.04)}.primary{background:#6558d5!important;color:#fff!important;border:0!important}.secondary{background:#fff!important;color:#5d50c9!important;border:1rpx solid #ddd9f7!important}.danger{background:#fff2f0!important;color:#b64f48!important;border:0!important}.muted{color:#929baa}.pill{display:inline-flex;align-items:center;border-radius:99rpx;padding:7rpx 14rpx;background:#efedff;color:#6255ce;font-size:20rpx}.empty{padding:100rpx 30rpx;text-align:center;color:#8c96a5}.empty text{display:block}.empty .empty-title{font-size:30rpx;color:#526075;font-weight:600;margin-bottom:12rpx}.feedback{padding:17rpx 20rpx;border-radius:14rpx;background:#f0eeff;color:#6255ce;font-size:22rpx;margin:18rpx 0}.readonly-banner{padding:17rpx 20rpx;border-radius:14rpx;background:#fff8e8;color:#9a6b17;font-size:22rpx;margin:18rpx 0}button{font-size:25rpx;border-radius:14rpx}button::after{border:0}input,textarea{font-size:26rpx}
view,text,input,textarea,button,picker{box-sizing:border-box}.page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom));overflow-x:hidden}.page-title,.page-subtitle{display:block;overflow-wrap:anywhere}.feedback,.readonly-banner{line-height:1.55;overflow-wrap:anywhere}.pill{max-width:100%}button,input,textarea{min-width:0}
